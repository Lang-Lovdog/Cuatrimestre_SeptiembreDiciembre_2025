\begin{frame}{Methodological Robustness Check}
\begin{block}{Cross-Validation Strategy}
\begin{itemize}
\item \textbf{10-fold cross-validation} on each dataset shuffle
\item \textbf{Stratified sampling} to maintain class distribution
\item \textbf{Multiple preprocessing pipelines} tested independently
\item \textbf{Hyperparameter tuning} within each configuration
\end{itemize}
\end{block}

\begin{block}{Robustness Assessment}
\begin{itemize}
\item \textbf{Consistent performance} across dataset variations
\item \textbf{Methodological transparency} in evaluation
\item \textbf{Statistical validation} of results
\item \textbf{Peer comparison} for benchmarking
\end{itemize}
\end{block}

