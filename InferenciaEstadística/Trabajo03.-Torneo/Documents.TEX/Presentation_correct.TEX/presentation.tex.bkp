\item \textbf{Your SVM}: Normal (p = 1.0) - but zero variance
\item \textbf{Peer RF}: Normal (p = 0.319)
\item \textbf{Your RF}: Normal (p = 1.0) - but zero variance
\end{itemize}
\end{block}
\end{frame}

