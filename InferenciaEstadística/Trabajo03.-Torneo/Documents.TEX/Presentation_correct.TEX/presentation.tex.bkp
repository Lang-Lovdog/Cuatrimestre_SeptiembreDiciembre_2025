\begin{frame}{Statistical Comparison: Overview}
\begin{columns}
\begin{column}{0.5\textwidth}
\begin{block}{Our Models}
\begin{itemize}
\item \textbf{KNN\_Cosine}: 0.8734
\item \textbf{MLP\_1Layer}: 0.8524  
